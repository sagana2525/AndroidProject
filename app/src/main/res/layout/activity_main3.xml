<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <Button
        android:id="@+id/button_1"
        android:text="1"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_2"
        app:layout_constraintTop_toBottomOf="@+id/button_4"/>

    <Button
        android:id="@+id/button_2"
        android:text="2"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_3"
        app:layout_constraintTop_toBottomOf="@+id/button_5"/>

    <Button
        android:id="@+id/button_3"
        android:text="3"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_sub"
        app:layout_constraintTop_toBottomOf="@+id/button_6"/>

    <Button
        android:id="@+id/button_4"
        android:text="4"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_5"
        app:layout_constraintTop_toBottomOf="@+id/button_7"/>

    <Button
        android:id="@+id/button_5"
        android:text="5"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_6"
        app:layout_constraintTop_toBottomOf="@+id/button_8"/>

    <Button
        android:id="@+id/button_6"
        android:text="6"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_mul"
        app:layout_constraintTop_toBottomOf="@+id/button_9"/>

    <Button
        android:id="@+id/button_7"
        android:text="7"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/textView_cal"
        app:layout_constraintEnd_toStartOf="@+id/button_8"/>

    <Button
        android:id="@+id/button_8"
        android:text="8"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/textView_cal"
        app:layout_constraintEnd_toStartOf="@+id/button_9"/>

    <Button
        android:id="@+id/button_9"
        android:text="9"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@+id/textView_cal"
        app:layout_constraintEnd_toStartOf="@+id/button_div"/>

    <Button
        android:id="@+id/button_0"
        android:text="0"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_equal"
        app:layout_constraintTop_toBottomOf="@+id/button_2"/>

    <Button
        android:id="@+id/button_ac"
        android:text="AC"
        android:textSize="16dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_0"
        app:layout_constraintTop_toBottomOf="@+id/button_1"/>

    <Button
        android:id="@+id/button_add"
        android:text="+"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_sub"/>

    <Button
        android:id="@+id/button_sub"
        android:text="-"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_mul"/>

    <Button
        android:id="@+id/button_mul"
        android:text="×"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_div"/>

    <Button
        android:id="@+id/button_div"
        android:text="÷"
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_cal"/>

    <Button
        android:id="@+id/button_equal"
        android:text="="
        android:textSize="25dp"
        android:layout_width="70dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toStartOf="@+id/button_add"
        app:layout_constraintTop_toBottomOf="@+id/button_3"/>

    <TextView
        android:id="@+id/textView_cal"
        android:text="0"
        android:textSize="64dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>